generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(120)
  email               String    @unique @db.VarChar(160)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  bio                 String?   @db.Text
  avatarUrl           String?   @map("avatar_url") @db.VarChar(500)
  role                String    @default("AUTHOR") @db.VarChar(40)
  resetTokenHash      String?   @map("reset_token_hash") @db.VarChar(255)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  articles     Article[]
  comments     Comment[]
  likes        ArticleLike[]
  bookmarks    ArticleBookmark[]
  reads        ArticleRead[]

  @@map("users")
}

model Article {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(180)
  summary        String?  @db.VarChar(280)
  content        String   @db.Text
  categoryId     Int?     @map("category_id")
  bannerImage    Bytes?   @map("banner_image") @db.LongBlob
  bannerMimeType String?  @map("banner_mime_type") @db.VarChar(80)
  viewsCount     Int      @default(0) @map("views_count")
  likesCount     Int      @default(0) @map("likes_count")
  bookmarksCount Int      @default(0) @map("bookmarks_count")
  authorId       Int      @map("author_id")
  publishedAt    DateTime @default(now()) @map("published_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           ArticleTag[]
  comments       Comment[]
  likes          ArticleLike[]
  bookmarks      ArticleBookmark[]
  reads          ArticleRead[]

  @@index([authorId])
  @@index([categoryId])
  @@map("articles")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  articles  Article[]

  @@map("categories")
}

model Tag {
  id        Int          @id @default(autoincrement())
  name      String       @unique @db.VarChar(80)
  createdAt DateTime     @default(now()) @map("created_at")
  articles  ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId Int     @map("article_id")
  tagId     Int     @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  articleId Int      @map("article_id")
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([authorId])
  @@map("comments")
}

model ArticleLike {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
  @@map("article_likes")
}

model ArticleBookmark {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
  @@map("article_bookmarks")
}

model ArticleRead {
  id              Int      @id @default(autoincrement())
  articleId       Int      @map("article_id")
  userId          Int?     @map("user_id")
  readerId        String   @map("reader_id") @db.VarChar(80)
  durationSeconds Int      @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@index([userId])
  @@index([readerId])
  @@map("article_reads")
}
